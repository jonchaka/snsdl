# Copy to .env next to docker-compose.yml, then `docker compose up -d`.
# Every line is optional; a commented-out line shows the default.
# The README's Configuration section explains each variable.

# ---- Container -------------------------------------------------------------
# Host port the page is served on
#PORT=8080
# UID and GID the app runs as; the data folder is re-owned to them at start (id -u / id -g)
#PUID=1000
#PGID=      # blank or unset: same as PUID
# Host folder mounted as /data (Portainer: use an absolute path such as /volume1/docker/snsdl/data)
#DATA_PATH=./data
# Timezone for the cron schedules and the download window
#TZ=UTC

# ---- Downloads -------------------------------------------------------------
# Simultaneous downloads
#MAX_CONCURRENT=2
# Downloads from one site at the same time; 0 = no per-site limit
#MAX_PER_SITE=1
# Seconds between two downloads from the same site (randomised); 0 disables
#SITE_GAP=3
# Most videos one playlist download can queue
#MAX_PLAYLIST_ITEMS=500
# Fragments of an HLS/DASH stream fetched at once (1-16)
#FRAGMENTS=1
# Cap each download's speed: 5M, 800K, 1.5M or bytes per second; empty = none
#RATE_LIMIT=
# Free space the download disk must keep; 0 disables the check
#MIN_FREE_SPACE=1G
# Embed the thumbnail as cover art in MP4 and MP3 files; 0 to skip
#EMBED_THUMBNAILS=1
# Browser fingerprint yt-dlp imitates (chrome, safari, chrome-120:windows-10...); empty disables
#IMPERSONATE=chrome
# Proxy for probes and downloads: http(s)://, socks4(a):// or socks5(h)://[user:password@]host:port
#PROXY=
# Only start downloads between two times in TZ, e.g. 22:00-06:00; empty = always
#DOWNLOAD_WINDOW=
# Longest a live recording may run before it is stopped and kept (1-168 hours)
#LIVE_MAX_HOURS=12

# ---- Page defaults ---------------------------------------------------------
# 1 ticks "Remove sponsor segments" the first time the page opens
#SPONSORBLOCK=0
# 1 ticks "Prefer H.264" the first time the page opens
#PREFER_H264=0

# ---- Keeping files ---------------------------------------------------------
# Host folder for kept files; uncomment the keep volume line in docker-compose.yml
#KEEP_PATH=./keep
# Directory inside the container that Keep moves files into (the keep volume's mount point);
# empty keeps them in data/downloads
#KEEP_DIR=
# 1 files kept downloads into one folder per uploader with .nfo and poster
# for Jellyfin, Plex or Kodi; needs KEEP_DIR
#MEDIA_LAYOUT=0

# ---- Schedules (cron syntax, in TZ) ----------------------------------------
# When to wipe downloads
#CLEANUP_CRON=0 3 * * *
# Instead of the nightly wipe, delete each download this many days after it
# finished; empty or 0 keeps the wipe
#RETENTION_DAYS=
# When to install the newest yt-dlp; empty disables
#UPDATE_CRON=0 4 * * *
# When to check subscriptions for new videos; empty = manual checks only
#SUBSCRIPTION_CRON=0 */6 * * *

# ---- Access ----------------------------------------------------------------
# PIN (4-64 characters, no spaces) the page asks for once per browser; empty = open
#ACCESS_PIN=
# Serve over HTTPS with a self-generated certificate (1/true/yes/on)
#HTTPS=0
# Addresses and names you open the page by, for the certificate: 192.168.1.10,nas.local
#TLS_HOSTS=
# The address you open the app by, as an origin (no path), used in webhook
# payloads, Telegram messages and podcast feed links
#PUBLIC_URL=

# ---- Notifications ---------------------------------------------------------
# http:// or https:// URL that gets a JSON POST when a download finishes or fails
#WEBHOOK_URL=
# Key for the webhook's X-SNS-Signature HMAC; empty sends unsigned
#WEBHOOK_SECRET=
# Telegram bot token as BotFather gives it; needs TELEGRAM_CHAT_ID
#TELEGRAM_BOT_TOKEN=
# Chat the bot sends to: a numeric id (-100... for a group or channel) or @name
#TELEGRAM_CHAT_ID=
